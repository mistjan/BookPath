{
  "name": "bookpath-initial-product",
  "version": "0.1.0",
  "private": true,
  "description": "BookPath initial Next.js product shell for literary discovery and reading paths.",
  "workspaces": [
    "apps/mobile",
    "apps/web",
    "packages/content",
    "packages/core",
    "packages/design-tokens"
  ],
  "scripts": {
    "dev": "npm --workspace @bookpath/web run dev",
    "build": "npm --workspace @bookpath/web run build",
    "lint": "npm --workspace @bookpath/web run lint",
    "web:start": "npm --workspace @bookpath/web run start",
    "web:check": "npm --workspace @bookpath/web run check",
    "mobile:start": "npm --workspace apps/mobile run start",
    "mobile:check": "npm --workspace apps/mobile run check",
    "mobile:web": "npm --workspace apps/mobile run web",
    "test": "npm --workspace @bookpath/web run test",
    "check": "npm --workspace @bookpath/web run check",
    "verify": "npm run check"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@supabase/supabase-js": "^2.46.1",
    "cheerio": "^1.2.0",
    "expo": "~55.0.25",
    "lucide-react": "^0.468.0",
    "next": "^15.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-native": "0.83.6",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@react-native-community/cli": "^20.1.3",
    "@types/node": "20.17.6",
    "@types/react": "19.2.14",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.15.0",
    "eslint-config-next": "^15.0.0",
    "postcss": "^8.4.49",
    "prettier": "^3.3.3",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.7.2"
  }
}
